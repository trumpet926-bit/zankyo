{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{6}$/)",
        "state": {
          ".write": "$code.matches(/^[0-9]{6}$/)",
          ".validate": "newData.hasChildren(['bpm', 'beats', 'running', 'anchorAt'])",
          "bpm": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 240"
          },
          "beats": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
          },
          "running": {
            ".validate": "newData.isBoolean()"
          },
          "anchorAt": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "action": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$other": {
            ".validate": false
          }
        },
        "calib": {
          ".write": "$code.matches(/^[0-9]{6}$/)",
          ".validate": "newData.hasChildren(['id', 'name', 'startAt', 'endAt'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "endAt": {
            ".validate": "newData.isNumber() && newData.val() > newData.parent().child('startAt').val() && newData.val() - newData.parent().child('startAt').val() <= 20000"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$memberId": {
            ".write": "$code.matches(/^[0-9]{6}$/) && $memberId.matches(/^[a-z0-9]{12}$/)",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "voice": {
          "$memberId": {
            ".write": "$code.matches(/^[0-9]{6}$/) && $memberId.matches(/^[a-z0-9]{12}$/)",
            ".validate": "newData.hasChildren(['name', 'sid'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "sid": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "signal": {
          "$to": {
            "$msg": {
              ".write": "$code.matches(/^[0-9]{6}$/) && $to.matches(/^[a-z0-9]{12}$/)",
              ".validate": "newData.hasChildren(['from', 'sid', 'to', 'type', 'data'])",
              "from": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)"
              },
              "sid": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)"
              },
              "to": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)"
              },
              "type": {
                ".validate": "newData.isString() && newData.val().matches(/^(offer|answer|ice)$/)"
              },
              "data": {
                ".validate": "newData.isString() && newData.val().length <= 20000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "take": {
          ".write": "$code.matches(/^[0-9]{6}$/)",
          ".validate": "newData.hasChildren(['id', 'by', 'startAt', 'recording', 'at'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-z-]{1,40}$/)"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "recording": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "cue": {
          ".write": "$code.matches(/^[0-9]{6}$/)",
          ".validate": "newData.hasChildren(['at', 'beats', 'bpm', 'by'])",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "beats": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
          },
          "bpm": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 240"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "clock": {
      "$memberId": {
        ".read": "$memberId.matches(/^[a-z0-9]{12}$/)",
        ".write": "$memberId.matches(/^[a-z0-9]{12}$/)",
        ".validate": "newData.isNumber()"
      }
    },
    "usage": {
      ".read": true,
      "days": {
        "$day": {
          "$id": {
            ".write": "$day.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $id.matches(/^[a-z0-9]{12}$/)",
            "p": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "s": {
              ".validate": "newData.isBoolean()"
            },
            "v": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "f": {
              "$feature": {
                ".validate": "newData.isBoolean() && $feature.matches(/^[a-z]{1,12}$/)"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "rooms": {
        "$day": {
          "$code": {
            "$id": {
              ".write": "$day.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $code.matches(/^[0-9]{6}$/) && $id.matches(/^[a-z0-9]{12}$/)",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
            }
          }
        }
      }
    },
    "remote": {
      "$id": {
        ".read": "$id.matches(/^[a-z0-9]{24}$/)",
        ".write": "$id.matches(/^[a-z0-9]{24}$/)",
        "cmd": {
          ".validate": "newData.hasChildren(['cmd', 'seq'])",
          "cmd": {
            ".validate": "newData.isString() && newData.val().matches(/^(toggle|up1|down1|up5|down5|rec)$/)"
          },
          "seq": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "status": {
          ".validate": "newData.hasChildren(['bpm', 'running', 'recording', 'rec', 'alive'])",
          "bpm": {
            ".validate": "newData.isNumber()"
          },
          "running": {
            ".validate": "newData.isBoolean()"
          },
          "recording": {
            ".validate": "newData.isBoolean()"
          },
          "rec": {
            ".validate": "newData.isNumber()"
          },
          "alive": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
